# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# GOOGLE WORKSPACE INTEGRATION
# Spreadsheet ID for database (Pegawai, SPD, SPJ)
GOOGLE_SPREADSHEET_ID="1hDBsEYcVWcESO2oXVHq49Wb-dMYDERPGiYr5YtcuzuY"
# Folder ID in G Drive for dokumentasi photos
GOOGLE_DRIVE_FOLDER_ID="1qqIzwZhFYyP0zVL1KL_MbUMGBikS63c6"
# Google Doc Templates
GOOGLE_DOC_SPD_TEMPLATE_ID="1-NIfpfHFTDnvVWbxjthqgsMFCfIV59X8R43zExK5w5I"
GOOGLE_DOC_SPJ_TEMPLATE_ID="1-jdPT0cmo8Qqxp_hgIxZSDuWXVxQQM41JwSVG-la0aE"
GOOGLE_DOC_LAPORAN_TEMPLATE_ID="1YtO_yxETvX5AbLyygyhurXNh9J0YKMS-D9niVL9Bu9Q"

# GOOGLE SERVICE ACCOUNT CREDENTIALS (METHOD 1 - ADVANCED)
